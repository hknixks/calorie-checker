# Copy this file to .env and fill in your key, then restart the dev server.
# Free key from https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Optional. Only change this if Google renames the free-tier model and you
# start seeing 404 errors when analysing a photo.
VITE_GEMINI_MODEL=gemini-2.5-flash
